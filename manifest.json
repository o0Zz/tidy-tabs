{
  "manifest_version": 3,
  "name": "Tidy Tabs",
  "version": "0.2.0",
  "description": "Keeps all tabs in one window and caps the number of tabs.",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Tidy Tabs",
    "default_popup": "popup.html"
  }
}
