{
  "manifest_version": 3,
  "name": "Tidy Tabs",
  "version": "0.0.0",
  "description": "Keeps all tabs in one window, caps the number of tabs and suggests tab groups.",
  "permissions": ["storage", "tabs", "tabGroups"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Tidy Tabs",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+F" },
      "description": "Open Tidy Tabs and search tabs"
    }
  },
  "options_page": "options.html"
}
